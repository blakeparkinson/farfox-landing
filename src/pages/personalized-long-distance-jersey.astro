---
import Layout from '../layouts/Layout.astro';
import catalog from '../data/catalog.json';
import { kitSlugForName } from '../lib/kits.mjs';
import JerseyOfferCard from '../components/JerseyOfferCard.astro';

const SITE = 'https://lovefarfox.com';
const SNIPCART_KEY = import.meta.env.PUBLIC_SNIPCART_KEY ?? 'ZDBhODA3ZGEtNzM5Zi00MGYxLTg4ODItOGY3NTYyMTQwNmRmNjM5MTYzNzE4NTA1NTczODE3';

type Product = {
  id: string;
  name: string;
  price: number;
  image: string;
  back?: string | null;
  sizes?: string[];
};

// Cards are chosen by kit, not product id, so a kit appears here as soon as
// `npm run sync` adds its Printful product to the catalog. Retired kits
// (Coordinates, Orange) are simply not listed.
const FEATURED_KITS = ['morse', 'moose-blush', 'paradise', 'flight', 'stars', 'twilight', 'mardigras'];
const PAIR_KITS = ['otherhalfa', 'otherhalfb'];
const allProducts = catalog.products as Product[];
const byKit = (kit: string) => allProducts.find((product) => kitSlugForName(product.name) === kit);
const present = (products: (Product | undefined)[]) => products.filter((product): product is Product => Boolean(product));
const jerseys = present(FEATURED_KITS.map(byKit));
const pair = present(PAIR_KITS.map(byKit));
const offers = [...pair, ...jerseys];

if (!jerseys.length) {
  throw new Error('No featured personalized jerseys found in the Printful catalog');
}

const fmt = (price: number) => Number.isInteger(price) ? `$${price}` : `$${price.toFixed(2)}`;
const faqs = [
  {
    question: 'Can I put any name and number on the back?',
    answer: 'Yes. Add up to 14 characters and a number up to three digits. Leave either field blank if you only want a name or a number.',
  },
  {
    question: 'Can we order matching jerseys?',
    answer: 'Absolutely. Add one personalized jersey for each partner to the cart, changing the size, name, and number before each add.',
  },
  {
    question: 'How is the jersey made?',
    answer: 'Each jersey is printed to order by Printful using an all-over print process, then shipped directly to you. That means less waste and no mass-produced inventory.',
  },
  {
    question: 'Where do you ship?',
    answer: 'Printful fulfills worldwide from the nearest available facility. Exact shipping options and delivery estimates appear during checkout.',
  },
];
---

<Layout
  title="Personalized Long-Distance Couple Jersey | Far Fox"
  description="Make a one-of-one Long Distance FC jersey with their name and number. A personalized gift for couples who are worth every mile."
  image={`${SITE}${jerseys[0].image}`}
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://app.snipcart.com" />
    <link rel="preconnect" href="https://cdn.snipcart.com" />
    <link rel="stylesheet" href="https://cdn.snipcart.com/themes/v3.7.1/default/snipcart.css" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Product',
      name: 'Personalized Long Distance FC Jersey',
      description: 'A personalized jersey for long-distance couples with a custom name and number.',
      image: offers.map((jersey) => `${SITE}${jersey.image}`),
      brand: { '@type': 'Brand', name: 'Far Fox' },
      offers: {
        '@type': 'AggregateOffer',
        lowPrice: Math.min(...offers.map((jersey) => jersey.price)),
        highPrice: Math.max(...offers.map((jersey) => jersey.price)),
        priceCurrency: 'USD',
        offerCount: offers.length,
        availability: 'https://schema.org/InStock',
      },
    })} />
  </Fragment>

  <nav class="fixed top-0 w-full z-50 backdrop-blur-md bg-fox-bg/85 border-b border-fox-pink/10">
    <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2">
        <img src="/brand/foxy-icon-v1.png" alt="" class="w-8 h-8" />
        <span class="text-xl font-900 tracking-tight bg-gradient-to-r from-fox-pink to-fox-purple bg-clip-text text-transparent">Far Fox</span>
      </a>
      <button class="snipcart-checkout flex items-center gap-2 text-sm font-800 hover:text-fox-pink transition-colors">
        Cart <span class="rounded-full bg-fox-pink text-white min-w-6 h-6 px-1 flex items-center justify-center snipcart-items-count">0</span>
      </button>
    </div>
  </nav>

  <main>
    <section class="pt-28 pb-16 px-6 overflow-hidden relative">
      <div class="absolute top-12 -left-24 w-96 h-96 rounded-full bg-fox-pink/10 blur-3xl"></div>
      <div class="absolute bottom-0 -right-24 w-96 h-96 rounded-full bg-fox-purple/10 blur-3xl"></div>
      <div class="max-w-6xl mx-auto grid lg:grid-cols-2 gap-10 lg:gap-16 items-center relative">
        <div class="order-2 lg:order-1">
          <p class="text-xs uppercase tracking-[0.25em] text-fox-pink font-900 mb-4">Made for the miles between you</p>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-900 tracking-tight leading-[1.03] mb-5">
            Their name. Their number.
            <span class="bg-gradient-to-r from-fox-pink to-fox-purple bg-clip-text text-transparent">Your team.</span>
          </h1>
          <p class="text-lg sm:text-xl text-fox-text-light leading-relaxed mb-7 max-w-xl">
            Turn the distance into something you wear with pride. Personalize a Long Distance FC jersey for them—or make a matching pair for both of you.
          </p>
          <div class="flex flex-wrap gap-x-5 gap-y-2 text-sm font-700 text-fox-text-light mb-8">
            <span>✓ Live personalization preview</span>
            <span>✓ Printed to order</span>
            <span>✓ Ships worldwide</span>
          </div>
          <a href="#make-yours" class="inline-flex px-8 py-4 rounded-full bg-gradient-to-r from-fox-pink to-fox-purple text-white font-900 text-lg hover:shadow-xl hover:shadow-fox-pink/30 transition-all hover:-translate-y-0.5">
            Make yours — {fmt(jerseys[0].price)} →
          </a>
          <p class="mt-3 text-xs text-fox-text-light/70">Secure checkout · No account required</p>
        </div>

        <div class="order-1 lg:order-2 relative">
          <div class="absolute inset-8 bg-gradient-to-br from-fox-pink/25 to-fox-purple/20 rounded-full blur-3xl"></div>
          <div class="relative rounded-[2.5rem] bg-white/70 border border-fox-pink/15 shadow-2xl shadow-fox-pink/15 p-4 sm:p-8">
            <img src={jerseys[0].image} alt="Personalized Long Distance FC jersey" class="w-full aspect-square object-contain" />
            <div class="absolute bottom-7 left-7 right-7 sm:bottom-12 sm:left-12 sm:right-12 rounded-2xl bg-white/90 backdrop-blur p-4 shadow-lg text-center">
              <p class="text-xs uppercase tracking-widest text-fox-text-light font-800">One relationship. One team.</p>
              <p class="font-900 text-lg mt-1">LONG DISTANCE FC</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="make-yours" class="py-16 sm:py-24 px-6 bg-white">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-10">
          <p class="text-xs uppercase tracking-[0.25em] text-fox-pink font-900 mb-3">Make it theirs</p>
          <h2 class="text-3xl sm:text-5xl font-900 tracking-tight mb-3">Choose your kit</h2>
          <p class="text-fox-text-light text-lg">Pick a design, type their name and number, then preview the back.</p>
        </div>

        {pair.length > 0 && (
          <div class="mb-10 rounded-[2rem] border-2 border-fox-pink/20 bg-fox-bg/40 p-4 sm:p-6">
            <div class="text-center mb-6">
              <p class="text-xs uppercase tracking-[0.25em] text-fox-pink font-900 mb-2">The Other Half kits</p>
              <h3 class="text-2xl sm:text-3xl font-900 tracking-tight">Each of you wears half.</h3>
            </div>
            <div class="grid sm:grid-cols-2 gap-6 lg:gap-8">
              {pair.map((jersey, index) => <JerseyOfferCard jersey={jersey} index={index} />)}
            </div>
          </div>
        )}

        <div class="grid sm:grid-cols-2 gap-6 lg:gap-8">
          {jerseys.map((jersey, index) => <JerseyOfferCard jersey={jersey} index={index} />)}
        </div>
      </div>
    </section>

    <section class="py-16 sm:py-24 px-6 bg-fox-text text-white">
      <div class="max-w-4xl mx-auto text-center">
        <img src="/brand/foxy-letter-v1.png" alt="" class="w-28 h-28 mx-auto mb-5 object-contain" loading="lazy" />
        <h2 class="text-3xl sm:text-5xl font-900 tracking-tight mb-5">A gift that only makes sense for the two of you.</h2>
        <p class="text-white/70 text-lg max-w-2xl mx-auto leading-relaxed">Not another generic “miss you” gift. It carries their name, your shared number, and the team you keep choosing across every mile.</p>
      </div>
    </section>

    <section class="py-16 sm:py-24 px-6">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl sm:text-4xl font-900 tracking-tight text-center mb-10">Before you order</h2>
        <div class="space-y-3">
          {faqs.map((faq) => (
            <details class="group rounded-2xl bg-white border border-fox-pink/10">
              <summary class="flex items-center justify-between gap-4 p-5 sm:p-6 cursor-pointer list-none font-900">
                {faq.question}<span class="text-fox-pink text-2xl group-open:rotate-45 transition-transform">+</span>
              </summary>
              <p class="px-5 sm:px-6 pb-5 sm:pb-6 text-fox-text-light leading-relaxed">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>

  <footer class="py-10 px-6 border-t border-fox-pink/10 text-center text-sm text-fox-text-light">
    <p><a href="/" class="font-900 text-fox-pink">Far Fox</a> · Built for couples who refuse to drift · <a href="/shop/" class="hover:text-fox-pink">Shop all</a></p>
  </footer>

  <div hidden id="snipcart" data-api-key={SNIPCART_KEY} data-config-modal-style="side"></div>
  <script is:inline src="https://cdn.snipcart.com/themes/v3.7.1/default/snipcart.js"></script>
  <script is:inline>
    (() => {
      const track = (name, data = {}) => {
        if (typeof window.umami?.track === 'function') {
          const campaign = window.farfoxAcquisition || {};
          window.umami.track(name, {
            ...data,
            source: campaign.utm_source || data.source || 'direct',
            medium: campaign.utm_medium || '',
            campaign: campaign.utm_campaign || '',
            content: campaign.utm_content || '',
          });
        }
      };
      track('jersey_offer_view', { source: new URLSearchParams(location.search).get('utm_source') || 'direct' });

      const swapImage = (image, src) => {
        if (!image || !src || image.getAttribute('src') === src) return;
        image.style.opacity = '0';
        const preload = new Image();
        preload.onload = () => { image.src = src; image.style.opacity = '1'; };
        preload.src = src;
      };

      const personalizedBack = (card) => {
        const id = card.dataset.product;
        const name = (document.getElementById(`name-${id}`)?.value || '').toUpperCase().trim();
        const number = (document.getElementById(`number-${id}`)?.value || '').replace(/[^0-9]/g, '');
        if (!name && !number) return null;
        return `/api/jersey-back.png?${new URLSearchParams({ kit: card.dataset.kit, name, number, w: '720' })}`;
      };

      document.querySelectorAll('.jersey-card').forEach((card) => {
        const id = card.dataset.product;
        const image = document.getElementById(`offer-img-${id}`);
        const buttons = card.querySelectorAll('.offer-view');
        const activate = (active) => buttons.forEach((button) => {
          const on = button === active;
          button.classList.toggle('bg-fox-pink', on);
          button.classList.toggle('text-white', on);
          button.classList.toggle('text-fox-text-light', !on);
        });

        buttons.forEach((button) => button.addEventListener('click', () => {
          const back = button.dataset.side === 'back';
          swapImage(image, (back && personalizedBack(card)) || button.dataset.src);
          activate(button);
          track('jersey_design_view', { product: id, side: button.dataset.side });
        }));

        let timer;
        card.querySelectorAll('.offer-personalize').forEach((input) => input.addEventListener('input', () => {
          if (input.id.startsWith('number-')) input.value = input.value.replace(/[^0-9]/g, '').slice(0, 3);
          clearTimeout(timer);
          timer = setTimeout(() => {
            const src = personalizedBack(card);
            if (src) {
              swapImage(image, src);
              activate(buttons[1]);
              track('jersey_personalized', { product: id });
            }
          }, 350);
        }));

        const add = card.querySelector('.offer-add');
        add.addEventListener('click', () => {
          const size = document.getElementById(`size-${id}`)?.value || '';
          const name = (document.getElementById(`name-${id}`)?.value || '').toUpperCase().trim();
          const number = (document.getElementById(`number-${id}`)?.value || '').replace(/[^0-9]/g, '');
          add.setAttribute('data-item-custom1-value', size);
          add.setAttribute('data-item-custom2-value', name);
          add.setAttribute('data-item-custom3-value', number);
          track('jersey_add_to_cart', { product: id, size, personalized: Boolean(name || number) });
        }, true);
      });

      document.addEventListener('snipcart.ready', () => {
        window.Snipcart?.events?.on('cart.confirmed', (order) => {
          track('jersey_purchase', { order: order?.invoiceNumber || 'confirmed', total: order?.total || 0 });
        });
      });
    })();
  </script>
</Layout>
