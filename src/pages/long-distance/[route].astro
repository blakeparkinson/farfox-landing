---
import ToolLayout from '../../layouts/ToolLayout.astro';
import { ROUTES, AWAKE, awakeWindows, bestCall, windowMinutes, clock, flightHours, gapSentence, hoursLabel, halfwayHubs, relatedRoutes, yearOfGaps, type Route } from '../../lib/ldrRoutes';
import { formatDistance, halfwayUrl } from '../../lib/halfwayPoint';

export function getStaticPaths() {
  return ROUTES.map((route) => ({ params: { route: route.slug }, props: { route } }));
}
const { route } = Astro.props as { route: Route };
const { a, b, km } = route;
const year = new Date().getUTCFullYear();
const gaps = yearOfGaps(a, b, year);
const usual = gaps.usual;
// A gap that holds for months is a season (Sydney's summer); a few weeks is clocks changing on different dates.
const seasonal = gaps.others.filter((o) => o.days > 60);
const brief = gaps.others.filter((o) => o.days <= 60);
const windows = awakeWindows(usual);
const overlap = windowMinutes(windows);
const call = bestCall(windows, usual);
const hubs = halfwayHubs(route);
const flight = flightHours(km);
const absHours = Math.abs(usual) / 60;
const range = seasonal.length ? `${hoursLabel(Math.min(usual, ...seasonal.map((s) => s.gap)))}–${hoursLabel(Math.max(usual, ...seasonal.map((s) => s.gap)))}`.replace(/ hours?–/, '–') : '';
const gapLine = seasonal.length
  ? `${b.city} is ${range} ${usual > 0 ? 'ahead of' : 'behind'} ${a.city}, depending on the time of year`
  : gapSentence(a, b, usual);
const briefLine = brief.length && !seasonal.length ? ` For about ${Math.round(brief.reduce((s, o) => s + o.days, 0) / 7)} weeks a year, when the two cities change their clocks on different dates, the gap is ${hoursLabel(brief[0].gap)} instead.` : '';
const callLine = call
  ? `The best time to call is usually ${clock(call.aFrom)}–${clock(call.aTo)} in ${a.city}, which is ${clock(call.bFrom)}–${clock(call.bTo)} in ${b.city}${seasonal.length ? ` (when you're ${hoursLabel(usual)} apart)` : ''}.`
  : `There is no hour when you are both comfortably awake, so most days will run on messages and voice notes, with a call one of you plans around.`;
const tips = absHours <= 3
  ? [`With ${hoursLabel(usual)} between you, you can share most evenings. Pick one standing call night a week anyway, so it never slides.`, 'Watch a show at the same time with a call open. A small gap makes live dates easy.', 'Use the difference: one of you can text the other good morning before they wake.']
  : absHours <= 8
    ? [`${a.city} evenings land in ${b.city}'s late night or early morning, so protect one window and treat it as your appointment.`, 'Trade a voice note when one of you wakes up. It is waiting for the other at the end of their day.', 'Keep a shared list of things to tell each other, so the call is not spent catching up on logistics.']
    : [`At ${hoursLabel(usual)} apart, one of you is asleep for most of the other's day. Agree who flexes on which days, so the late calls are shared.`, 'Lean on asynchronous rituals: a daily question you both answer, photos of your day, a letter you each add to.', 'Plan one long weekend call a week, when nobody has work in the morning.'];
const halfway = (() => { const u = new URL(halfwayUrl(Astro.site?.origin ?? 'https://lovefarfox.com', { label: a.city, lat: a.lat, lon: a.lon }, { label: b.city, lat: b.lat, lon: b.lon })); u.search = ''; return `${u.pathname}${u.hash}`; })();
const related = relatedRoutes(route);
const title = `${a.city} to ${b.city}: Time Difference & Best Time to Call | Far Fox`;
const description = `${gapLine}. See the hours you're both awake, the distance (${formatDistance(km)}), and the fairest place to meet halfway between ${a.city} and ${b.city}.`;
const faqs: [string, string][] = [
  [`What is the time difference between ${a.city} and ${b.city}?`, `${gapLine}.${briefLine}`],
  [`What is the best time to call between ${a.city} and ${b.city}?`, overlap ? `${callLine} That gives you about ${hoursLabel(overlap)} a day when you are both awake, between 8 AM and 11 PM local time.` : callLine],
  [`How far is ${a.city} from ${b.city}?`, `${formatDistance(km)} in a straight line. A non-stop flight takes about ${flight} hours.`],
  ...(hubs.length ? [[`Where can a couple meet halfway between ${a.city} and ${b.city}?`, `The fairest cities to meet in are ${hubs.map((h) => h.city).join(', ')}. ${hubs[0].city} is ${formatDistance(hubs[0].fromKm)} from ${a.city} and ${formatDistance(hubs[0].toKm)} from ${b.city}.`] as [string, string]] : []),
];
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(([q, ans]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: ans } })) };
const utm = `utm_source=route_guide&utm_medium=onsite&utm_campaign=city_pairs&utm_content=${route.slug}`;
---
<ToolLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <p class="crumbs"><a href="/long-distance/">Long-distance city guides</a> / {a.city} and {b.city}</p>
  <h1>{a.city} to {b.city}: time difference, best time to call, and where to meet</h1>
  <p class="lede">{gapLine}.{briefLine} {callLine}</p>

  <section class="clocks" data-clocks data-a-tz={a.tz} data-b-tz={b.tz} aria-label="Current time in both cities">
    <div><span>{a.city}</span><strong data-clock="a">–</strong></div>
    <div><span>{b.city}</span><strong data-clock="b">–</strong></div>
  </section>

  <section class="facts">
    <article><h2>Hours you're both awake</h2>
      {windows.length ? (
        <ul>{windows.map((w) => <li><strong>{clock(w.aFrom)}–{clock(w.aTo)}</strong> in {a.city} = <strong>{clock(w.bFrom)}–{clock(w.bTo)}</strong> in {b.city}</li>)}</ul>
      ) : <p>None between 8 AM and 11 PM. Plan your calls around a weekend morning or a late night one of you can spare.</p>}
      <p class="small">{overlap ? `About ${hoursLabel(overlap)} a day, counting each of you awake from ${clock(AWAKE.from)} to ${clock(AWAKE.to)}.` : ''} <a href={`/long-distance-time-zone-calculator/?${utm}`}>Set your own hours →</a></p>
    </article>
    <article><h2>How far apart you are</h2>
      <p class="big">{formatDistance(km)}</p>
      <p>About <strong>{flight} hours</strong> on a non-stop flight.</p>
    </article>
    <article><h2>Where to meet halfway</h2>
      {hubs.length ? (
        <ul>{hubs.map((h) => <li><strong>{h.city}</strong>, {h.country}: {formatDistance(h.fromKm)} from {a.city}, {formatDistance(h.toKm)} from {b.city}</li>)}</ul>
      ) : <p>There is no big hub in between, so one of you visiting is the simplest plan.</p>}
      <p class="small"><a href={halfway}>See it on the halfway calculator →</a></p>
    </article>
  </section>

  <section class="tips"><h2>Making {a.city}–{b.city} work</h2><ul>{tips.map((t) => <li>{t}</li>)}</ul></section>

  <section class="next">
    <article><h2>Count down to your next visit</h2><p>Set the date and send them a countdown.</p><a href={`/reunion-countdown/?${utm}`} data-umami-event="route-countdown" data-umami-event-route={route.slug}>Start a reunion countdown →</a></article>
    <article><h2>{a.city} and {b.city} on one map</h2><p>A personalised print of the two of you, and the distance in between.</p><a href={`/personalized-long-distance-map/?${utm}`} data-umami-event="route-map" data-umami-event-route={route.slug}>Make your map →</a></article>
    <article><h2>Stay close day to day</h2><p>Far Fox gives you a daily question, shared rituals, and a fox you raise together.</p><a href={`https://app.lovefarfox.com/signup?ref=route_${route.slug}`} data-umami-event="route-app" data-umami-event-route={route.slug}>Try Far Fox free →</a></article>
  </section>

  <section class="faq"><h2>Questions couples ask</h2>{faqs.map(([q, ans]) => <details><summary>{q}</summary><p>{ans}</p></details>)}</section>

  {related.length > 0 && <section class="related"><h2>More city guides</h2><ul>{related.map((r) => <li><a href={`/long-distance/${r.slug}/`}>{r.a.city} to {r.b.city}</a></li>)}</ul></section>}
</ToolLayout>

<script>
  // Live clocks, in each city's own zone, so the page is right whatever the season.
  const box = document.querySelector<HTMLElement>('[data-clocks]');
  if (box) {
    const fmt = (tz: string) => new Intl.DateTimeFormat('en-US', { timeZone: tz, hour: 'numeric', minute: '2-digit', weekday: 'short' });
    const a = fmt(box.dataset.aTz!), b = fmt(box.dataset.bTz!);
    const tick = () => { const now = new Date(); box.querySelector('[data-clock="a"]')!.textContent = a.format(now); box.querySelector('[data-clock="b"]')!.textContent = b.format(now); };
    tick(); setInterval(tick, 30000);
  }
</script>

<style>
  .crumbs{font-size:.85rem;font-weight:800}.lede{font-size:1.15rem;max-width:760px}
  .clocks{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:24px 0;max-width:620px}
  .clocks div{background:var(--panel);border:1px solid var(--line);border-radius:20px;padding:16px 20px}
  .clocks span{display:block;font-size:.85rem;font-weight:800;color:var(--accent)}.clocks strong{font-size:1.6rem;font-weight:900}
  .facts{display:grid;grid-template-columns:1.4fr 1fr 1.4fr;gap:20px;margin:32px 0}
  .facts article,.next article{background:var(--panel);border:1px solid var(--line);border-radius:24px;padding:22px}
  .facts h2,.next h2,.tips h2,.faq h2,.related h2{font-size:1.2rem}.facts ul,.tips ul{list-style:disc;padding-left:1.25rem;line-height:1.7;color:var(--muted)}.facts li,.tips li{margin:6px 0}
  .big{font-size:1.5rem;font-weight:900;color:var(--ink)!important}.small{font-size:.9rem}
  .tips{margin:40px 0;max-width:760px}
  .next{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin:40px 0}.next a{font-weight:800}
  .faq{max-width:760px;margin:40px 0}.faq details{border-bottom:1px solid var(--line);padding:12px 0}.faq summary{font-weight:800;cursor:pointer}
  .related ul{display:flex;flex-wrap:wrap;gap:10px;list-style:none;padding:0}.related a{display:inline-block;padding:8px 14px;border:1px solid var(--line);border-radius:999px;text-decoration:none;font-weight:700}
  @media(max-width:860px){.facts,.next{grid-template-columns:1fr}}
  @media(max-width:480px){.clocks strong{font-size:1.2rem}}
</style>
