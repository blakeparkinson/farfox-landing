---
import Layout from '../../layouts/Layout.astro';
import { COMPETITORS } from '../../lib/competitors';
---

<Layout
  title="Far Fox vs Other Couples Apps: Honest Comparisons"
  description="Side-by-side comparisons of Far Fox with Paired, Couple, Between, Lasting, and LokLok — so long-distance couples can pick the right app the first time."
>
  <main class="min-h-screen pt-24 pb-20 px-6 bg-gradient-to-b from-fox-bg via-white to-fox-bg">
    <div class="max-w-3xl mx-auto">
      <img src="/brand/foxy-face-v1.png" alt="Far Fox companion" class="w-20 h-20 mb-5 drop-shadow-lg" width="80" height="80" />
      <h1 class="text-4xl sm:text-5xl font-900 tracking-tight leading-tight mb-4">
        How Far Fox <span class="bg-gradient-to-r from-fox-pink to-fox-purple bg-clip-text text-transparent">compares</span>
      </h1>
      <p class="text-fox-text-light text-lg leading-relaxed mb-10">
        Every couples app makes the same promise. These comparisons stay honest about where each app
        actually wins — including where Far Fox does not.
      </p>
      <div class="space-y-4">
        {COMPETITORS.map((competitor) => (
          <a href={`/compare/${competitor.slug}`} class="block rounded-2xl bg-white border border-fox-pink/10 p-6 hover:border-fox-pink/30 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-fox-pink/10 transition-all">
            <h2 class="font-900 text-xl mb-1.5">Far Fox vs {competitor.name}</h2>
            <p class="text-fox-text-light text-sm leading-relaxed">{competitor.name}: {competitor.tagline}.</p>
          </a>
        ))}
      </div>
      <p class="mt-10 text-fox-text-light">
        Want the full landscape first? Read the
        <a href="/blog/best-long-distance-relationship-apps" class="text-fox-pink font-700 hover:underline">complete long-distance app roundup</a>.
      </p>
    </div>
  </main>
</Layout>
