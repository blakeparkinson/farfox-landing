---
import Layout from '../../layouts/Layout.astro';
import { COMPETITORS, FAR_FOX_FEATURES } from '../../lib/competitors';

export function getStaticPaths() {
  return COMPETITORS.map((competitor) => ({
    params: { slug: competitor.slug },
    props: { competitor },
  }));
}

const { competitor } = Astro.props;
const title = `Far Fox vs ${competitor.name} (2026): Which Couples App Fits You?`;
const description = `An honest comparison of Far Fox and ${competitor.name} for long-distance couples — features, pricing, and who each app is actually best for.`;
const signup = `https://app.lovefarfox.com/signup?ref=compare_${competitor.slug}`;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: competitor.faqs.map(([question, answer]) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
};
---

<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <main class="min-h-screen pt-24 pb-20 px-6 bg-gradient-to-b from-fox-bg via-white to-fox-bg">
    <div class="max-w-3xl mx-auto">
      <nav aria-label="Breadcrumb" class="mb-8 text-sm text-fox-text-light/60">
        <a href="/" class="hover:text-fox-pink">Home</a>
        <span class="mx-1.5 text-fox-text-light/30">/</span>
        <a href="/compare" class="hover:text-fox-pink">Compare</a>
        <span class="mx-1.5 text-fox-text-light/30">/</span>
        <span class="text-fox-text-light/80">Far Fox vs {competitor.name}</span>
      </nav>

      <img src="/fox-face.png" alt="Far Fox companion" class="w-20 h-20 mb-5 drop-shadow-lg" width="80" height="80" />
      <h1 class="text-4xl sm:text-5xl font-900 tracking-tight leading-tight mb-4">
        Far Fox vs <span class="bg-gradient-to-r from-fox-pink to-fox-purple bg-clip-text text-transparent">{competitor.name}</span>
      </h1>
      <p class="text-fox-text-light text-lg leading-relaxed mb-10">
        {competitor.name} — {competitor.tagline}. Far Fox — daily rituals for couples who live apart.
        Here is where each one genuinely wins, so you can pick the right app instead of downloading both.
      </p>

      <section class="grid sm:grid-cols-2 gap-5 mb-12">
        <div class="rounded-2xl border border-fox-pink/15 bg-white p-6">
          <h2 class="font-900 text-lg mb-4">Where {competitor.name} wins</h2>
          <ul class="space-y-3">
            {competitor.strengths.map((item) => (
              <li class="flex gap-2.5 text-fox-text-light text-sm leading-relaxed"><span class="text-fox-purple font-900">+</span>{item}</li>
            ))}
          </ul>
        </div>
        <div class="rounded-2xl border border-fox-pink/15 bg-white p-6">
          <h2 class="font-900 text-lg mb-4">Where Far Fox differs</h2>
          <ul class="space-y-3">
            {competitor.gaps.map((item) => (
              <li class="flex gap-2.5 text-fox-text-light text-sm leading-relaxed"><span class="text-fox-pink font-900">+</span>{item}</li>
            ))}
          </ul>
        </div>
      </section>

      <section class="mb-12">
        <h2 class="text-2xl font-900 tracking-tight mb-4">What Far Fox includes free</h2>
        <div class="flex flex-wrap gap-2">
          {FAR_FOX_FEATURES.map((feature) => (
            <span class="px-3.5 py-1.5 rounded-full bg-fox-pink/8 border border-fox-pink/15 text-sm font-700 text-fox-text">{feature}</span>
          ))}
        </div>
        <p class="text-fox-text-light text-sm mt-4">{competitor.pricingNote}</p>
      </section>

      <section class="mb-12">
        <h2 class="text-2xl font-900 tracking-tight mb-4">The honest verdict</h2>
        <div class="space-y-3">
          <p class="text-fox-text-light leading-relaxed"><strong class="text-fox-text">Pick {competitor.name} if</strong> {competitor.pickThemIf}</p>
          <p class="text-fox-text-light leading-relaxed"><strong class="text-fox-text">Pick Far Fox if</strong> {competitor.pickFarFoxIf}</p>
        </div>
      </section>

      <section class="mb-12 space-y-3">
        <h2 class="text-2xl font-900 tracking-tight mb-4">Common questions</h2>
        {competitor.faqs.map(([question, answer]) => (
          <details class="rounded-2xl bg-white border border-fox-pink/10 p-5">
            <summary class="font-800 cursor-pointer">{question}</summary>
            <p class="mt-3 text-fox-text-light leading-relaxed">{answer}</p>
          </details>
        ))}
      </section>

      <div class="rounded-3xl bg-gradient-to-br from-fox-pink to-fox-purple text-white p-8 text-center">
        <h2 class="text-2xl sm:text-3xl font-900 mb-3">Try the free one first.</h2>
        <p class="text-white/90 mb-6 max-w-md mx-auto">
          Far Fox takes about three minutes to set up. Your first daily question drops the moment your partner joins.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href={signup} data-app-cta={`compare_${competitor.slug}`} class="px-7 py-3.5 rounded-full bg-white text-fox-pink font-900 hover:-translate-y-0.5 transition-transform">Start Far Fox free →</a>
          <a href={`/quiz?utm_source=compare&utm_medium=onsite&utm_campaign=love_profile_loop&utm_content=${competitor.slug}`} class="px-7 py-3.5 rounded-full border-2 border-white/30 font-900 hover:bg-white/10">Or take the couple quiz</a>
        </div>
      </div>

      <div class="mt-10 text-sm text-fox-text-light">
        More comparisons:
        {COMPETITORS.filter((c) => c.slug !== competitor.slug).map((c, index) => (
          <span>{index > 0 && ' · '}<a href={`/compare/${c.slug}`} class="text-fox-pink font-700 hover:underline">Far Fox vs {c.name}</a></span>
        ))}
        <span> · <a href="/blog/best-long-distance-relationship-apps" class="text-fox-pink font-700 hover:underline">Full app roundup</a></span>
      </div>
    </div>
  </main>
</Layout>
