---
import Layout from '../layouts/Layout.astro';
import { CITIES, REGIONS } from '../lib/timeZones';

const quizUrl = '/quiz?utm_source=tz_calculator&utm_medium=onsite&utm_campaign=love_profile_loop';

const faqs: [string, string][] = [
  [
    'How do I find the best time to call my long-distance partner?',
    'Map when you are both actually awake, then pick a standing slot inside that overlap — not at the edges, when one of you is just waking up or already done for the day. A protected 30–60 minutes at a fixed time beats a longer call that only happens when you both happen to be free.',
  ],
  [
    'What if our time zones barely overlap?',
    'Shift from live calls to a relay: voice notes, photos, and scheduled messages that land when they wake up. Keep one or two real-time calls a week at a time someone agrees to flex for. A 12-hour gap is workable if you stop treating instant replies as the measure of love.',
  ],
  [
    'Does this calculator handle daylight saving time?',
    'Yes. It uses each city’s real timezone, including DST, so New York vs London in March is a different gap than in July. Recheck around the two Sundays a year when clocks change — that is when “we always call at 8” quietly breaks.',
  ],
  [
    'How many hours apart is too many for a long-distance relationship?',
    'There isn’t a number that decides it. Couples make 12-hour gaps work every day. What predicts strain is an undefined schedule: no protected overlap, no async ritual, and reading silence as rejection. Design the rhythm and the hours become a constraint, not a verdict.',
  ],
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(([question, answer]) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
};

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'Find overlap hours with a long-distance partner',
  description: 'Pick two cities, set wake and sleep times, and see the hours you are both awake.',
  step: [
    { '@type': 'HowToStep', name: 'Choose cities', text: 'Select your city and your partner’s city.' },
    { '@type': 'HowToStep', name: 'Set waking hours', text: 'Adjust when each of you typically wakes and sleeps.' },
    { '@type': 'HowToStep', name: 'Read the overlap', text: 'The highlighted hours are your golden window for calls and dates.' },
  ],
};

const citiesJson = JSON.stringify(CITIES);
---

<Layout
  title="Long-Distance Time Zone Calculator — Find Your Overlap Hours | Far Fox"
  description="Free time zone calculator for long-distance couples. Pick two cities, see the hour difference, and find the overlap when you are both awake — including daylight saving."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />

  <nav class="fixed top-0 w-full z-50 backdrop-blur-md bg-fox-bg/80 border-b border-fox-pink/10">
    <div class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2">
        <img src="/fox-logo.png" alt="Far Fox" class="w-8 h-8" />
        <span class="text-xl font-900 tracking-tight bg-gradient-to-r from-fox-pink to-fox-purple bg-clip-text text-transparent">Far Fox</span>
      </a>
      <a href="https://app.lovefarfox.com" data-app-cta="tz_nav" class="px-5 py-2 rounded-full bg-gradient-to-r from-fox-pink to-fox-purple text-white font-700 text-sm hover:shadow-lg hover:shadow-fox-pink/25 transition-all duration-200 hover:-translate-y-0.5">Open App</a>
    </div>
  </nav>

  <main class="pt-24 pb-20 px-6 bg-gradient-to-b from-fox-bg via-white to-fox-bg">
    <div class="max-w-2xl mx-auto">
      <div class="text-center mb-10">
        <img src="/fox-face.png" alt="Far Fox companion" class="w-20 h-20 mx-auto mb-5 drop-shadow-lg" width="80" height="80" />
        <h1 class="text-3xl sm:text-5xl font-900 tracking-tight leading-tight mb-4">
          Find the hours you’re
          <span class="bg-gradient-to-r from-fox-pink via-fox-purple to-fox-orange bg-clip-text text-transparent">both awake</span>
        </h1>
        <p class="text-fox-text-light text-lg leading-relaxed max-w-xl mx-auto">
          A free time zone calculator for long-distance couples. Pick two cities, set when you actually sleep, and see your overlap — including daylight saving.
        </p>
      </div>

      <section class="rounded-3xl bg-white border border-fox-pink/10 p-5 sm:p-8 shadow-sm mb-10" aria-label="Time zone overlap calculator">
        <div class="grid sm:grid-cols-2 gap-4 mb-5">
          <label class="block">
            <span class="text-xs font-900 uppercase tracking-wider text-fox-pink mb-1.5 block">You</span>
            <select id="tz-you" class="w-full rounded-xl border border-fox-pink/15 bg-fox-bg/50 px-3 py-3 font-800 text-fox-text">
              {REGIONS.map((region) => (
                <optgroup label={region}>
                  {CITIES.filter((c) => c.region === region).map((c) => (
                    <option value={c.tz} data-city={c.city}>{c.city}</option>
                  ))}
                </optgroup>
              ))}
            </select>
            <p id="tz-you-now" class="mt-2 text-sm font-800 text-fox-text"></p>
          </label>
          <label class="block">
            <span class="text-xs font-900 uppercase tracking-wider text-fox-purple mb-1.5 block">Them</span>
            <select id="tz-them" class="w-full rounded-xl border border-fox-pink/15 bg-fox-bg/50 px-3 py-3 font-800 text-fox-text">
              {REGIONS.map((region) => (
                <optgroup label={region}>
                  {CITIES.filter((c) => c.region === region).map((c) => (
                    <option value={c.tz} data-city={c.city}>{c.city}</option>
                  ))}
                </optgroup>
              ))}
            </select>
            <p id="tz-them-now" class="mt-2 text-sm font-800 text-fox-text"></p>
          </label>
        </div>

        <p id="tz-diff" class="text-center font-900 text-xl sm:text-2xl mb-6 text-fox-text"></p>

        <div class="grid sm:grid-cols-2 gap-4 mb-6">
          <fieldset class="rounded-2xl bg-fox-bg/60 p-4">
            <legend class="text-xs font-900 uppercase tracking-wider text-fox-pink px-1">Your waking hours</legend>
            <div class="flex gap-3 mt-2">
              <label class="flex-1 text-sm font-700 text-fox-text-light">Wake
                <input id="wake-you" type="number" min="0" max="23" value="7" class="mt-1 w-full rounded-lg border border-fox-pink/15 px-2 py-2 font-800 text-fox-text" />
              </label>
              <label class="flex-1 text-sm font-700 text-fox-text-light">Sleep
                <input id="sleep-you" type="number" min="0" max="23" value="23" class="mt-1 w-full rounded-lg border border-fox-pink/15 px-2 py-2 font-800 text-fox-text" />
              </label>
            </div>
          </fieldset>
          <fieldset class="rounded-2xl bg-fox-bg/60 p-4">
            <legend class="text-xs font-900 uppercase tracking-wider text-fox-purple px-1">Their waking hours</legend>
            <div class="flex gap-3 mt-2">
              <label class="flex-1 text-sm font-700 text-fox-text-light">Wake
                <input id="wake-them" type="number" min="0" max="23" value="7" class="mt-1 w-full rounded-lg border border-fox-pink/15 px-2 py-2 font-800 text-fox-text" />
              </label>
              <label class="flex-1 text-sm font-700 text-fox-text-light">Sleep
                <input id="sleep-them" type="number" min="0" max="23" value="23" class="mt-1 w-full rounded-lg border border-fox-pink/15 px-2 py-2 font-800 text-fox-text" />
              </label>
            </div>
          </fieldset>
        </div>

        <p class="text-xs font-800 uppercase tracking-wider text-fox-text-light mb-2">Your day (24 hours)</p>
        <div id="tz-bar" class="grid grid-cols-24 gap-px mb-2" style="grid-template-columns: repeat(24, minmax(0, 1fr));"></div>
        <div class="flex justify-between text-[10px] font-800 text-fox-text-light/70 mb-5">
          <span>12am</span><span>6am</span><span>12pm</span><span>6pm</span><span>12am</span>
        </div>

        <div id="tz-overlap" class="rounded-2xl bg-gradient-to-r from-fox-pink/8 to-fox-purple/8 border border-fox-pink/10 p-5 mb-4"></div>

        <button id="tz-share" type="button" class="w-full sm:w-auto px-6 py-3 rounded-full border-2 border-fox-pink/30 font-800 hover:border-fox-pink transition-colors">
          Copy link to this pair
        </button>
      </section>

      <section class="mb-12">
        <h2 class="text-2xl sm:text-3xl font-900 tracking-tight mb-4">How to use the overlap</h2>
        <p class="text-fox-text-light leading-relaxed mb-4">
          The highlighted hours are the only window where a live call is fair to both of you. Protect one slot inside that window the way you’d protect a date: same time, most days, phones down. Edge hours (the first hour after waking, the last hour before sleep) make for short, grouchy check-ins. Sit in the middle of the overlap if you can.
        </p>
        <p class="text-fox-text-light leading-relaxed mb-4">
          If the overlap is under two hours, stop expecting the relationship to run on FaceTime. That is when <a href="/blog/long-distance-relationship-time-zones" class="text-fox-pink font-700 hover:underline">async rituals</a> do the real work: voice notes through your day, a photo they wake up to, a letter scheduled for their morning. The calculator tells you when you can talk. The rituals cover the rest of the clock.
        </p>
        <p class="text-fox-text-light leading-relaxed">
          Recheck this page when clocks change. A standing “8pm your time” call can quietly become 3am for them twice a year, and that is how couples start thinking the other person “stopped trying.”
        </p>
      </section>

      <section class="mb-12">
        <h2 class="text-2xl sm:text-3xl font-900 tracking-tight mb-5">Common questions</h2>
        <div class="space-y-3">
          {faqs.map(([question, answer]) => (
            <details class="rounded-2xl bg-white border border-fox-pink/10 p-5">
              <summary class="font-800 cursor-pointer">{question}</summary>
              <p class="mt-3 text-fox-text-light leading-relaxed">{answer}</p>
            </details>
          ))}
        </div>
      </section>

      <div class="rounded-3xl bg-gradient-to-br from-fox-pink to-fox-purple text-white p-8 text-center">
        <h2 class="text-2xl sm:text-3xl font-900 mb-3">Use the overlap for something better than “wyd”</h2>
        <p class="text-white/90 mb-6 max-w-md mx-auto">A two-minute quiz you each take. Then a side-by-side reveal of how you actually want to be loved across the gap.</p>
        <a href={quizUrl} class="inline-flex px-9 py-3.5 rounded-full bg-white text-fox-pink font-900 text-lg hover:-translate-y-0.5 transition-transform">Take the couple quiz →</a>
      </div>

      <p class="mt-10 text-fox-text-light text-sm text-center">
        More on making the gap work: <a href="/blog/long-distance-relationship-time-zones" class="text-fox-pink font-700 hover:underline">time-zone relationship guide</a>
        · <a href="/blog/long-distance-relationship-texts" class="text-fox-pink font-700 hover:underline">texts that land while they sleep</a>
        · <a href="/blog/how-to-make-a-long-distance-relationship-work" class="text-fox-pink font-700 hover:underline">the complete LDR guide</a>
      </p>
    </div>
  </main>

  <footer class="py-12 px-6 border-t border-fox-pink/10">
    <div class="max-w-5xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
      <a href="/" class="font-800 text-lg bg-gradient-to-r from-fox-pink to-fox-purple bg-clip-text text-transparent">Far Fox</a>
      <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-sm text-fox-text-light/50">
        <a href="/quiz" class="hover:text-fox-pink transition-colors">Couple Quiz</a>
        <a href="/blog" class="hover:text-fox-pink transition-colors">Blog</a>
        <a href="/privacy" class="hover:text-fox-pink transition-colors">Privacy</a>
      </div>
    </div>
  </footer>
</Layout>

<script define:vars={{ citiesJson }}>
  const CITIES = JSON.parse(citiesJson);

  const $ = (id) => document.getElementById(id);
  const youSel = $('tz-you');
  const themSel = $('tz-them');
  const bar = $('tz-bar');
  const overlapEl = $('tz-overlap');
  const diffEl = $('tz-diff');
  const youNow = $('tz-you-now');
  const themNow = $('tz-them-now');
  const shareBtn = $('tz-share');

  function cityName(tz) {
    return CITIES.find((c) => c.tz === tz)?.city || tz;
  }

  function offsetMinutes(timeZone) {
    const part = new Intl.DateTimeFormat('en-US', {
      timeZone,
      timeZoneName: 'longOffset',
    }).formatToParts(new Date()).find((p) => p.type === 'timeZoneName')?.value || 'GMT+0';
    const m = part.match(/GMT([+-])(\d{1,2})(?::(\d{2}))?/);
    if (!m) return 0;
    const sign = m[1] === '-' ? -1 : 1;
    return sign * (parseInt(m[2], 10) * 60 + parseInt(m[3] || '0', 10));
  }

  function formatNow(tz) {
    return new Intl.DateTimeFormat('en-US', {
      timeZone: tz,
      weekday: 'short',
      hour: 'numeric',
      minute: '2-digit',
    }).format(new Date());
  }

  function isAwake(hour, wake, sleep) {
    const w = ((wake % 24) + 24) % 24;
    const s = ((sleep % 24) + 24) % 24;
    if (w === s) return true;
    if (w < s) return hour >= w && hour < s;
    return hour >= w || hour < s;
  }

  function themHourForYouHour(youH, youTz, themTz) {
    const utcMinutes = youH * 60 - offsetMinutes(youTz);
    let themMinutes = utcMinutes + offsetMinutes(themTz);
    themMinutes = ((themMinutes % (24 * 60)) + 24 * 60) % (24 * 60);
    return Math.floor(themMinutes / 60);
  }

  function fmtHour(h) {
    const suffix = h >= 12 ? 'pm' : 'am';
    const hr = ((h + 11) % 12) + 1;
    return `${hr}${suffix}`;
  }

  function describeHours(hours) {
    if (hours.length === 0) return '';
    if (hours.length === 24) return 'all day';
    const sorted = [...hours].sort((a, b) => a - b);
    const contiguous = sorted[sorted.length - 1] - sorted[0] === sorted.length - 1;
    if (contiguous) {
      return `${fmtHour(sorted[0])}–${fmtHour((sorted[sorted.length - 1] + 1) % 24)}`;
    }
    return sorted.map(fmtHour).join(', ');
  }

  function pickDefaultYou() {
    const guessed = Intl.DateTimeFormat().resolvedOptions().timeZone;
    const match = CITIES.find((c) => c.tz === guessed);
    if (match) return match.tz;
    return 'America/New_York';
  }

  function readParams() {
    const q = new URLSearchParams(location.search);
    return { you: q.get('you'), them: q.get('them') };
  }

  function writeParams(you, them) {
    const url = new URL(location.href);
    url.searchParams.set('you', you);
    url.searchParams.set('them', them);
    history.replaceState(null, '', url);
  }

  function render() {
    const youTz = youSel.value;
    const themTz = themSel.value;
    const wakeYou = Number($('wake-you').value);
    const sleepYou = Number($('sleep-you').value);
    const wakeThem = Number($('wake-them').value);
    const sleepThem = Number($('sleep-them').value);
    const now = new Date();

    youNow.textContent = `Right now: ${formatNow(youTz)}`;
    themNow.textContent = `Right now: ${formatNow(themTz)}`;

    const diffMin = offsetMinutes(themTz) - offsetMinutes(youTz);
    const absH = Math.abs(diffMin) / 60;
    const hoursLabel = Number.isInteger(absH) ? String(absH) : absH.toFixed(1);
    if (diffMin === 0) {
      diffEl.textContent = 'Same clock. Different city.';
    } else if (diffMin > 0) {
      diffEl.textContent = `They are ${hoursLabel} hour${absH === 1 ? '' : 's'} ahead`;
    } else {
      diffEl.textContent = `They are ${hoursLabel} hour${absH === 1 ? '' : 's'} behind`;
    }

    const overlapYou = [];
    const overlapThem = [];
    bar.replaceChildren();
    for (let youH = 0; youH < 24; youH++) {
      const themH = themHourForYouHour(youH, youTz, themTz);
      const both = isAwake(youH, wakeYou, sleepYou) && isAwake(themH, wakeThem, sleepThem);
      if (both) {
        overlapYou.push(youH);
        overlapThem.push(themH);
      }
      const cell = document.createElement('div');
      cell.title = `${fmtHour(youH)} you / ${fmtHour(themH)} them`;
      cell.style.height = '2rem';
      cell.style.borderRadius = '2px';
      cell.style.background = both
        ? 'linear-gradient(to bottom, #FF6B8A, #B76CFD)'
        : 'rgba(255,107,138,0.12)';
      bar.appendChild(cell);
    }

    const youCity = cityName(youTz);
    const themCity = cityName(themTz);
    if (overlapYou.length === 0) {
      overlapEl.innerHTML = `<p class="font-900 text-lg mb-2">No live overlap with these waking hours.</p>
        <p class="text-fox-text-light leading-relaxed">Someone flexes sleep for a weekly call, and the rest of the week runs on voice notes and scheduled messages. A 12-hour gap is a design problem, not a love problem.</p>`;
    } else {
      overlapEl.innerHTML = `<p class="font-900 text-lg mb-2">${overlapYou.length} overlapping hour${overlapYou.length === 1 ? '' : 's'}</p>
        <p class="text-fox-text-light leading-relaxed mb-2">In ${youCity}: <strong class="text-fox-text">${describeHours(overlapYou)}</strong>. In ${themCity}: <strong class="text-fox-text">${describeHours(overlapThem)}</strong>.</p>
        <p class="text-fox-text-light leading-relaxed">Park a standing call in the middle of that window. Colored hours on the bar are when you’re both up.</p>`;
    }

    writeParams(youTz, themTz);
  }

  const params = readParams();
  youSel.value = params.you && CITIES.some((c) => c.tz === params.you) ? params.you : pickDefaultYou();
  themSel.value = params.them && CITIES.some((c) => c.tz === params.them) ? params.them : 'Europe/London';
  if (youSel.value === themSel.value) themSel.value = youSel.value === 'Europe/London' ? 'Asia/Tokyo' : 'Europe/London';

  [youSel, themSel, $('wake-you'), $('sleep-you'), $('wake-them'), $('sleep-them')].forEach((el) => {
    el.addEventListener('change', render);
    el.addEventListener('input', render);
  });

  shareBtn.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(location.href);
      shareBtn.textContent = 'Copied';
      setTimeout(() => { shareBtn.textContent = 'Copy link to this pair'; }, 1600);
    } catch {
      shareBtn.textContent = 'Copy the URL from the address bar';
    }
    window.umami?.track('timezone_pair_shared', { you: youSel.value, them: themSel.value });
  });

  render();
  window.umami?.track('timezone_calculator_used', { you: youSel.value, them: themSel.value });
</script>
