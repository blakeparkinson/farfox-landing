---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const collections = [
  {
    title: 'Visits & milestones',
    description: 'The first meeting, hard goodbyes, and the road to closing the distance.',
    paths: [
      'long-distance-reunion-checklist',
      'meeting-long-distance-partner-first-time',
      'post-visit-blues-long-distance-relationship',
      'long-distance-relationship-timeline',
      'closing-the-distance-long-distance-relationship',
    ],
  },
  {
    title: 'Stay close day to day',
    description: 'Questions, letters, games, dates, and rituals that make ordinary days feel shared.',
    paths: [
      'long-distance-relationship-questions',
      'long-distance-date-ideas',
      'love-letter-prompts-long-distance',
      'long-distance-relationship-games',
    ],
  },
  {
    title: 'Work through the hard parts',
    description: 'Clear, practical guidance for trust, conflict, time zones, and keeping your connection steady.',
    paths: [
      'how-to-handle-arguments-in-a-long-distance-relationship',
      'how-to-build-trust-in-a-long-distance-relationship',
      'long-distance-relationship-time-zones',
      'how-to-keep-the-spark-alive-in-a-long-distance-relationship',
    ],
  },
].map((collection) => ({
  ...collection,
  posts: collection.paths
    .map((path) => posts.find((post) => post.id === path))
    .filter((post): post is (typeof posts)[number] => Boolean(post)),
}));
---

<Layout title="Long-Distance Relationship Blog — Tips, Questions & Ideas | Far Fox" description="Practical advice for long-distance couples: conversation questions, date ideas, love letter prompts, gift guides, and daily rituals that keep your relationship strong across any distance.">
  <nav class="fixed top-0 w-full z-50 backdrop-blur-md bg-fox-bg/80 border-b border-fox-pink/10">
    <div class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2">
        <img src="/brand/foxy-icon-v1.png" alt="Far Fox" class="w-8 h-8" />
        <span class="text-xl font-900 tracking-tight bg-gradient-to-r from-fox-pink to-fox-purple bg-clip-text text-transparent">
          Far Fox
        </span>
      </a>
      <a
        href="https://app.lovefarfox.com"
        class="px-5 py-2 rounded-full bg-gradient-to-r from-fox-pink to-fox-purple text-white font-700 text-sm hover:shadow-lg hover:shadow-fox-pink/25 transition-all duration-200 hover:-translate-y-0.5"
      >
        Open App
      </a>
    </div>
  </nav>

  <main class="pt-28 pb-24 px-6">
    <div class="max-w-3xl mx-auto">
      <h1 class="text-3xl sm:text-4xl font-900 tracking-tight mb-4">
        Long-Distance Relationship <span class="bg-gradient-to-r from-fox-pink to-fox-purple bg-clip-text text-transparent">Guides</span>
      </h1>
      <p class="text-fox-text-light text-lg mb-12">
        Practical, honest advice for couples making long-distance work — questions to ask, love letters to write, gifts that mean something, and daily rituals that keep you close across any distance.
      </p>

      <section aria-labelledby="guide-collections" class="mb-14">
        <h2 id="guide-collections" class="text-2xl font-900 tracking-tight mb-6">Start with what you need</h2>
        <div class="grid gap-5 sm:grid-cols-3">
          {collections.map((collection) => (
            <section class="rounded-2xl bg-gradient-to-br from-fox-pink/5 to-fox-purple/5 border border-fox-pink/10 p-5">
              <h3 class="font-800 text-lg mb-2">{collection.title}</h3>
              <p class="text-sm text-fox-text-light leading-relaxed mb-4">{collection.description}</p>
              <ul class="space-y-2">
                {collection.posts.map((post) => (
                  <li><a href={`/blog/${post.id}`} class="text-sm font-700 text-fox-pink hover:underline">{post.data.title}</a></li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </section>

      <h2 class="text-2xl font-900 tracking-tight mb-6">Latest guides</h2>
      <div class="space-y-8">
        {posts.map((post) => (
          <a href={`/blog/${post.id}`} class="block group p-6 rounded-2xl bg-white/70 border border-fox-pink/8 hover:border-fox-pink/20 hover:shadow-lg hover:shadow-fox-pink/8 transition-all duration-200 hover:-translate-y-1">
            <p class="text-sm text-fox-text-light/60 mb-2">
              {new Date(`${post.data.date}T12:00:00`).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </p>
            <h2 class="text-xl font-800 mb-2 group-hover:text-fox-pink transition-colors">{post.data.title}</h2>
            <p class="text-fox-text-light leading-relaxed">{post.data.description}</p>
          </a>
        ))}
      </div>
    </div>
  </main>

  <footer class="py-12 px-6 border-t border-fox-pink/10">
    <div class="max-w-5xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
      <span class="font-800 text-lg bg-gradient-to-r from-fox-pink to-fox-purple bg-clip-text text-transparent">Far Fox</span>
      <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-sm text-fox-text-light/50">
        <a href="/quiz" class="hover:text-fox-pink transition-colors">Couple Quiz</a>
        <a href="/long-distance-time-zone-calculator" class="hover:text-fox-pink transition-colors">Time Zones</a>
        <a href="/shop" class="hover:text-fox-pink transition-colors">Shop</a>
        <a href="/blog" class="hover:text-fox-pink transition-colors">Blog</a>
        <a href="/privacy" class="hover:text-fox-pink transition-colors">Privacy</a>
        <a href="/terms" class="hover:text-fox-pink transition-colors">Terms</a>
        <a href="mailto:blake@lovefarfox.com" class="hover:text-fox-pink transition-colors">Contact</a>
        <span>&copy; {new Date().getFullYear()} Far Fox</span>
      </div>
    </div>
  </footer>
</Layout>
