---
import Layout from '../layouts/Layout.astro';

const signup = 'https://app.lovefarfox.com/signup?ref=search_landing';
const faqs = [
  ['Is Far Fox free?', 'Yes. Core features are free, with no ads and no selling your relationship data.'],
  ['Do both partners need an account?', 'Yes. One person creates the shared fox and sends the private invite link to their partner.'],
  ['Is it only for romantic long-distance relationships?', 'Far Fox is designed for adult romantic couples living apart—whether because of college, deployment, work, travel, or immigration.'],
  ['What happens after we join?', 'Once both partners connect, your first daily question appears and your shared fox wakes up.'],
];
---

<Layout
  title="Long-Distance Relationship App for Couples | Far Fox"
  description="Far Fox gives long-distance couples something meaningful to do together every day: questions, love letters, photos, challenges, countdowns, and a shared fox."
>
  <main>
    <section class="min-h-screen pt-24 pb-16 px-6 flex items-center relative overflow-hidden">
      <div class="absolute top-16 -left-20 w-96 h-96 bg-fox-pink/12 rounded-full blur-3xl"></div>
      <div class="absolute bottom-8 -right-20 w-96 h-96 bg-fox-purple/12 rounded-full blur-3xl"></div>
      <div class="max-w-6xl mx-auto grid lg:grid-cols-2 gap-12 items-center relative">
        <div class="text-center lg:text-left">
          <img src="/fox-face.png" alt="Far Fox companion" class="w-24 h-24 mx-auto lg:mx-0 mb-5 drop-shadow-lg" />
          <p class="text-xs uppercase tracking-[0.25em] text-fox-pink font-900 mb-4">Built specifically for couples apart</p>
          <h1 class="text-4xl sm:text-6xl font-900 tracking-tight leading-[1.03] mb-5">
            Stop asking
            <span class="bg-gradient-to-r from-fox-pink to-fox-purple bg-clip-text text-transparent">“how was your day?”</span>
          </h1>
          <p class="text-lg sm:text-xl text-fox-text-light leading-relaxed mb-7 max-w-xl mx-auto lg:mx-0">
            Far Fox turns the quiet between calls into daily rituals: questions, letters, photos, games, plans, and one small fox you raise together.
          </p>
          <a href={signup} data-app-cta="search_hero" class="inline-flex px-9 py-4 rounded-full bg-gradient-to-r from-fox-pink to-fox-purple text-white font-900 text-lg hover:-translate-y-0.5 hover:shadow-xl hover:shadow-fox-pink/30 transition-all">
            Start together for free →
          </a>
          <p class="mt-3 text-xs text-fox-text-light">Both partners join · About three minutes · iOS, Android, and Web</p>
        </div>
        <div class="flex justify-center lg:justify-end">
          <div class="relative bg-fox-text rounded-[2.5rem] p-2 shadow-2xl shadow-fox-pink/25 w-[270px] sm:w-[310px]">
            <img src="/screenshots/hero-home.png" alt="Far Fox app home screen for a connected couple" class="rounded-[2rem] w-full" />
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 sm:py-24 px-6 bg-white">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl sm:text-4xl font-900 tracking-tight mb-3">A reason to open the app tomorrow</h2>
          <p class="text-fox-text-light text-lg">Messaging keeps you informed. Rituals keep you connected.</p>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {[
            ['💬', 'Daily questions', 'Answer separately, then reveal both answers together.'],
            ['💌', 'Love letters', 'Write the things that deserve more space than a text bubble.'],
            ['🔥', 'Games and challenges', 'Turn another night on your phone into something shared.'],
            ['📸', 'Private photo timeline', 'See the small parts of each other’s day without posting publicly.'],
            ['📅', 'Plans and countdowns', 'Keep the next visit visible when the wait feels endless.'],
            ['🐾', 'Your shared fox', 'It grows when both of you show up—never from one person carrying everything.'],
          ].map(([emoji, title, description]) => (
            <article class="rounded-2xl border border-fox-pink/10 bg-fox-bg/40 p-6">
              <div class="text-3xl mb-3">{emoji}</div>
              <h3 class="font-900 text-lg mb-2">{title}</h3>
              <p class="text-fox-text-light text-sm leading-relaxed">{description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="py-16 sm:py-24 px-6 bg-fox-text text-white">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl sm:text-5xl font-900 tracking-tight mb-10">Both people matter from minute one.</h2>
        <div class="grid sm:grid-cols-3 gap-7">
          <div><div class="text-4xl font-900 text-fox-pink mb-2">1</div><h3 class="font-900 mb-2">Create your fox</h3><p class="text-white/65 text-sm">One partner starts the shared space.</p></div>
          <div><div class="text-4xl font-900 text-fox-pink mb-2">2</div><h3 class="font-900 mb-2">Invite your person</h3><p class="text-white/65 text-sm">Send one private connection link.</p></div>
          <div><div class="text-4xl font-900 text-fox-pink mb-2">3</div><h3 class="font-900 mb-2">Build the ritual</h3><p class="text-white/65 text-sm">Your first question drops when both join.</p></div>
        </div>
        <a href={signup} data-app-cta="search_steps" class="inline-flex mt-10 px-9 py-4 rounded-full bg-white text-fox-pink font-900 text-lg">Create our fox →</a>
      </div>
    </section>

    <section class="py-16 sm:py-24 px-6">
      <div class="max-w-3xl mx-auto">
        <div class="rounded-3xl bg-gradient-to-br from-fox-pink/12 to-fox-purple/12 border border-fox-pink/15 p-7 sm:p-10 text-center mb-16">
          <p class="text-xs uppercase tracking-widest text-fox-pink font-900 mb-3">Not ready to create an account?</p>
          <h2 class="text-2xl sm:text-3xl font-900 mb-3">Compare your love profiles first.</h2>
          <p class="text-fox-text-light mb-6">Six questions each. A side-by-side result. No signup required.</p>
          <a href="/quiz?utm_source=search_landing&utm_medium=onsite&utm_campaign=love_profile_loop" class="inline-flex px-7 py-3.5 rounded-full border-2 border-fox-pink text-fox-pink font-900">Take the couple quiz →</a>
        </div>
        <h2 class="text-3xl font-900 tracking-tight text-center mb-8">Questions couples ask</h2>
        <div class="space-y-3">
          {faqs.map(([question, answer]) => (
            <details class="rounded-2xl bg-white border border-fox-pink/10 p-5">
              <summary class="font-900 cursor-pointer">{question}</summary>
              <p class="mt-3 text-fox-text-light">{answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(([question, answer]) => ({
      '@type': 'Question',
      name: question,
      acceptedAnswer: { '@type': 'Answer', text: answer },
    })),
  })} />
</Layout>
