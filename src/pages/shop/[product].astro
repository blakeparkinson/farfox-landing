---
import Layout from '../../layouts/Layout.astro';
import catalog from '../../data/catalog.json';
import stories from '../../data/product-stories.json';
import ShopNav from '../../components/ShopNav.astro';
import ShopFooter from '../../components/ShopFooter.astro';
import ShopCart from '../../components/ShopCart.astro';
import ProductImage from '../../components/ProductImage.astro';
import ProductBuy from '../../components/ProductBuy.astro';
import { cartLive } from '../../lib/snipcart';
import { kitSlugForName } from '../../lib/kits.mjs';
import { SITE, PAIRS, formatPrice, kindOf, productPath, productStory, productTitle, productUrl, relatedProducts, shopCategoryOf, type ShopProduct } from '../../lib/productPages';

const PRODUCTS = catalog.products as ShopProduct[];

export function getStaticPaths() {
  return (catalog.products as ShopProduct[]).map((product) => ({ params: { product: productPath(product).split('/')[2] }, props: { product } }));
}

const { product: p } = Astro.props as { product: ShopProduct };
const kind = kindOf(p);
const story = productStory(p, stories as Record<string, string>);
const pair = PRODUCTS.find((o) => o.id === PAIRS[p.id]);
const related = relatedProducts(p, PRODUCTS);
const personalised = Boolean(kitSlugForName(p.name));
const category = shopCategoryOf(p.name);
const plainName = p.name.replace(/"/g, '');
const title = `${plainName}: Gift for Long-Distance Couples | Far Fox Shop`;
const description = `${story.split(/(?<=\.)\s/)[0]} ${formatPrice(p.price)}, printed to order and shipped worldwide.`;
const images = [p.image, p.back, ...(p.colors ?? []).flatMap((c) => [c.image, c.back])].filter((x): x is string => Boolean(x));

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: productTitle(p),
  description: `${story} ${kind.facts.join('. ')}.`,
  sku: p.id,
  url: productUrl(p),
  image: [...new Set(images)].map((i) => `${SITE}${i}`),
  brand: { '@type': 'Brand', name: 'Far Fox' },
  category: kind.productType,
  ...(p.colors?.length ? { color: p.colors.map((c) => c.name).join(', ') } : {}),
  ...(p.sizes?.length ? { size: p.sizes.join(', ') } : {}),
  offers: {
    '@type': 'Offer',
    url: productUrl(p),
    price: p.price.toFixed(2),
    priceCurrency: p.currency || 'USD',
    availability: 'https://schema.org/InStock',
    itemCondition: 'https://schema.org/NewCondition',
  },
};
const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Shop', item: `${SITE}/shop/` },
    { '@type': 'ListItem', position: 2, name: plainName, item: productUrl(p) },
  ],
};
---

<Layout title={title} description={description} image={`${SITE}${p.image}`}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} />
    {cartLive && (
      <Fragment>
        <link rel="preconnect" href="https://app.snipcart.com" />
        <link rel="preconnect" href="https://cdn.snipcart.com" />
        <link rel="stylesheet" href="https://cdn.snipcart.com/themes/v3.7.1/default/snipcart.css" />
      </Fragment>
    )}
  </Fragment>

  <ShopNav />

  <main class="pt-28 pb-16 px-6" data-product-page>
    <div class="max-w-6xl mx-auto">
      <p class="text-sm font-700 text-fox-text-light mb-6">
        <a href="/shop/" class="hover:text-fox-pink">Shop</a> <span aria-hidden="true">/</span> {category} <span aria-hidden="true">/</span> <span class="text-fox-text">{plainName}</span>
      </p>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-14 items-start">
        <ProductImage product={p} eager class="rounded-3xl border border-fox-pink/10" />

        <div class="flex flex-col">
          <h1 class="text-3xl sm:text-4xl font-900 tracking-tight leading-tight mb-2">{p.name}</h1>
          <p class="text-2xl font-900 text-fox-pink mb-5">{formatPrice(p.price)}</p>
          <p class="text-fox-text-light leading-relaxed mb-6">{story}</p>
          <ProductBuy product={p} />
          <p class="mt-4 text-sm text-fox-text-light">Printed to order and shipped worldwide{personalised ? ', with or without a name and number' : ''}. Every order helps keep the Far Fox app free.</p>

          <div class="mt-8 border-t border-fox-pink/10 pt-6">
            <h2 class="font-800 text-lg mb-3">Details</h2>
            <ul class="list-disc pl-5 space-y-1.5 text-fox-text-light">
              {kind.facts.map((f) => <li>{f}</li>)}
              {p.colors && p.colors.length > 1 && <li>{p.colors.length} colours: {p.colors.map((c) => c.name).join(', ')}</li>}
              {kind.apparel && p.sizes?.length ? <li>Unisex sizes {p.sizes[0]} to {p.sizes[p.sizes.length - 1]}</li> : null}
            </ul>
          </div>

          {pair && (
            <a href={productPath(pair)} class="mt-6 flex items-center gap-4 rounded-2xl border border-fox-pink/20 bg-fox-pink/[0.05] p-4 hover:border-fox-pink/40 transition-colors">
              <img src={pair.image} alt={pair.name} class="w-20 h-20 object-contain rounded-xl bg-white" loading="lazy" />
              <span><span class="block text-xs font-800 uppercase tracking-wide text-fox-pink">Made as a pair</span><span class="font-800">{pair.name}</span><span class="block text-sm text-fox-text-light">One for you, one for them. {formatPrice(pair.price)}</span></span>
            </a>
          )}
          {personalised && (
            <p class="mt-6 text-sm text-fox-text-light">Making one for a birthday or an anniversary? <a href="/personalized-long-distance-jersey/" class="font-800 text-fox-pink hover:text-fox-purple">See how personalised jerseys work →</a></p>
          )}
        </div>
      </div>

      <section class="mt-16 rounded-3xl bg-gradient-to-br from-fox-pink/[0.07] to-fox-purple/[0.07] p-6 sm:p-8">
        <h2 class="text-xl font-900 mb-2">A gift for someone far away</h2>
        <p class="text-fox-text-light leading-relaxed max-w-3xl">Ship it straight to their door: put their address in at checkout and it goes to them, not you. Looking for more ideas? Read our <a href="/blog/long-distance-relationship-gifts/" class="font-800 text-fox-pink hover:text-fox-purple">long-distance gift guide</a> or the <a href="/blog/long-distance-care-package-ideas/" class="font-800 text-fox-pink hover:text-fox-purple">care package checklist</a>.</p>
      </section>

      <section class="mt-16">
        <h2 class="text-2xl font-900 tracking-tight mb-6">You might also like</h2>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
          {related.map((r) => (
            <a href={productPath(r)} class="group rounded-3xl bg-white/70 border border-fox-pink/10 overflow-hidden hover:border-fox-pink/25 hover:shadow-lg transition-all">
              <img src={r.image} alt={r.name} class="w-full aspect-square object-contain p-2 bg-gradient-to-br from-fox-bg to-white" loading="lazy" />
              <span class="block px-4 pt-3 font-800 leading-tight group-hover:text-fox-pink">{r.name}</span>
              <span class="block px-4 pb-4 pt-1 font-900 text-fox-pink">{formatPrice(r.price)}</span>
            </a>
          ))}
        </div>
        <p class="mt-8 text-center"><a href="/shop/" class="font-800 text-fox-pink hover:text-fox-purple">See the whole shop →</a></p>
      </section>
    </div>
  </main>

  <ShopFooter />
  <ShopCart />
</Layout>
