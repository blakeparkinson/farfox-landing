---
import { GAME_CHOICES } from '../lib/heroGame';
---
<section class="play-hero" aria-labelledby="hero-heading">
  <div class="hero-copy">
    <p class="eyebrow">For couples who live apart</p>
    <h1 id="hero-heading">Less small talk.<br />More you two.</h1>
    <p class="intro">Daily questions, love letters, and a little fox that grows with your relationship. Start with one question.</p>
    <a class="text-link" href="https://app.lovefarfox.com/signup?ref=homepage_hero" data-app-cta="homepage_hero">Try Far Fox Free →</a>
  </div>
  <div class="game" id="reunion-game">
    <div class="game-heading">
      <img src="/brand/foxy-letter-v1.png" alt="Foxy holding a love letter" width="92" height="92" fetchpriority="high" />
      <div><p class="game-label">A little Would You Rather</p><p id="game-context">One question. No signup.</p></div>
    </div>
    <h2>You’re finally together.<br />First night: what’s the plan?</h2>
    <div class="choices" role="group" aria-label="Choose your reunion date">
      {GAME_CHOICES.map((choice, i) => <button type="button" data-choice={i} aria-pressed="false" disabled><span aria-hidden="true">{i === 0 ? 'A' : 'B'}</span>{choice}</button>)}
    </div>
    <div class="game-result" aria-live="polite" aria-atomic="true"><p id="game-response">Pick your favorite. Then ask your person.</p></div>
    <div id="game-actions" hidden>
      <div class="share-prompt">
        <p class="share-title">Send the same question to your person</p>
        <p class="share-note">They answer before seeing your choice. Then you both get the reveal.</p>
      </div>
      <button type="button" class="share-button" id="game-share">Copy partner link</button>
      <div id="game-copy" hidden><label for="game-link">Copy this link to send it yourself</label><input id="game-link" readonly /></div>
      <p id="share-status" role="status"></p>
      <a class="text-link quiz-link" href="/quiz?utm_source=homepage&utm_medium=onsite&utm_campaign=reunion_game" data-umami-event="hero_quiz_clicked">Take the couple quiz →</a>
    </div>
    <noscript><p>Turn on JavaScript to play, or <a href="/couple-quiz">explore the couple quiz</a>.</p></noscript>
  </div>
</section>
<script>
  import { GAME_CHOICES, invitationUrl, readInvitation } from '../lib/heroGame';
  const root = document.querySelector<HTMLElement>('#reunion-game')!;
  const response = root.querySelector<HTMLElement>('#game-response')!;
  const share = root.querySelector<HTMLButtonElement>('#game-share')!;
  const status = root.querySelector<HTMLElement>('#share-status')!;
  let invited = readInvitation(location.hash);
  let selected: number | null = null;
  let sharing = false;
  const track = (event: string, data: Record<string, string> = {}) => {
    try { (window as Window & { umami?: { track: (event: string, data: object) => void } }).umami?.track(event, data); } catch { /* Analytics must never interrupt the game. */ }
  };
  function reset() {
    invited = readInvitation(location.hash);
    selected = null;
    root.querySelector<HTMLElement>('#game-context')!.textContent = invited === null ? 'One question. No signup.' : 'Your person picked. Your turn.';
    root.querySelector<HTMLElement>('#game-actions')!.hidden = true;
    root.querySelector<HTMLElement>('#game-copy')!.hidden = true;
    status.textContent = '';
    response.textContent = invited === null ? 'Pick your favorite. Then ask your person.' : 'Pick first. Then see what your person chose.';
    root.querySelectorAll<HTMLButtonElement>('[data-choice]').forEach(button => { button.disabled = false; button.setAttribute('aria-pressed', 'false'); });
    if (invited !== null) track('hero_partner_landed');
  }
  reset();
  window.addEventListener('hashchange', reset);
  root.querySelectorAll<HTMLButtonElement>('[data-choice]').forEach(button => button.addEventListener('click', () => {
    const first = selected === null;
    selected = Number(button.dataset.choice);
    root.querySelectorAll('[data-choice]').forEach(option => option.setAttribute('aria-pressed', String(option === button)));
    response.textContent = invited === null ? 'Good choice. Would your person pick the same?' : `${selected === invited ? 'Same plan. It’s a date!' : 'Different plans. Sounds like a two-night visit.'} Your person picked: ${GAME_CHOICES[invited]}.`;
    root.querySelector<HTMLElement>('#game-actions')!.hidden = false;
    root.querySelector<HTMLElement>('#game-copy')!.hidden = true;
    status.textContent = '';
    share.textContent = invited === null ? 'Copy partner link' : 'Copy a new partner link';
    if (first) track(invited === null ? 'hero_answered' : 'hero_partner_completed');
  }));
  share.addEventListener('click', async () => {
    if (selected === null || sharing) return;
    const url = invitationUrl(location.origin, selected);
    sharing = true;
    share.disabled = true;
    status.textContent = '';
    try {
      try {
        await navigator.clipboard.writeText(url);
        status.textContent = 'Partner link copied. Paste it into your chat.';
        track('hero_invite_shared', { method: 'clipboard' });
      } catch {
        const field = root.querySelector<HTMLInputElement>('#game-link')!;
        field.value = url;
        root.querySelector<HTMLElement>('#game-copy')!.hidden = false;
        field.focus(); field.select();
        status.textContent = 'Automatic copying isn’t available. Select and copy the link above.';
      }
    } finally { sharing = false; share.disabled = false; }
  });
</script>
<style>
  .play-hero { max-width: 1152px; margin: auto; padding: 112px 24px 56px; display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 64px; }
  .eyebrow { font-size: .78rem; font-weight: 900; letter-spacing: .13em; text-transform: uppercase; color: #96415d; margin-bottom: 18px; }
  h1 { font-size: clamp(2.7rem, 4.3vw, 3.8rem); font-weight: 900; line-height: 1.08; letter-spacing: -.045em; }
  .intro { font-size: 1.13rem; line-height: 1.65; margin: 24px 0; max-width: 430px; color: #6b5b7b; }
  .text-link { color: #963655; font-weight: 900; text-underline-offset: 5px; text-decoration: underline; display: inline-block; padding: 10px 0; }
  .game { min-width: 0; background: #fffaf7; border: 2px solid #efd2d9; border-radius: 28px; padding: 26px; box-shadow: 0 9px 0 #efd2d9, 0 24px 48px #9636550b; }
  .game-heading { display: flex; gap: 16px; align-items: center; margin-bottom: 16px; }
  .game-heading img { object-fit: contain; flex-shrink: 0; }
  .game-label { font-weight: 900; font-size: .94rem; }
  #game-context { font-size: .82rem; color: #6b5b7b; margin-top: 4px; }
  h2 { font-weight: 900; font-size: 1.55rem; line-height: 1.3; margin-bottom: 22px; letter-spacing: -.02em; }
  .choices { display: grid; gap: 12px; }
  .choices button { min-height: 64px; display: flex; align-items: center; gap: 12px; text-align: left; background: #fff; padding: 12px 16px; border: 2px solid #e8dbe1; border-radius: 16px; box-shadow: 0 3px 0 #e8dbe1; font-weight: 800; cursor: pointer; }
  .choices span { display: grid; place-items: center; width: 30px; height: 30px; flex-shrink: 0; background: #f9edf0; border-radius: 9px; color: #963655; font-size: .8rem; }
  .choices button[aria-pressed=true] { border-color: #a63b60; box-shadow: 0 3px 0 #a63b60; background: #fff0f4; }
  button:disabled { cursor: default; opacity: .65; }
  button:active:not(:disabled) { transform: translateY(2px); }
  button:hover:not(:disabled) { border-color: #a63b60; }
  :is(button,a,input):focus-visible { outline: 3px solid #963655; outline-offset: 5px; }
  .game-result { min-height: 64px; padding-top: 20px; font-size: .92rem; font-weight: 700; line-height: 1.5; }
  .share-prompt { margin-top: 2px; padding: 14px 16px; border-radius: 16px; background: #f9edf0; }
  .share-title { color: #2d1b4e; font-weight: 900; font-size: .92rem; }
  .share-prompt .share-note { margin-top: 3px; }
  .share-button { width: 100%; border-radius: 16px; background: #963655; color: #fff; font-weight: 900; padding: 14px; cursor: pointer; margin-top: 12px; }
  .share-note, #share-status, #game-copy { font-size: .78rem; color: #6b5b7b; margin-top: 10px; line-height: 1.5; }
  #share-status:empty { display: none; }
  .quiz-link { font-size: .9rem; margin-top: 6px; }
  #game-link { display: block; width: 100%; border: 1px solid #963655; border-radius: 8px; padding: 8px; background: #fff; color: #2d1b4e; }
  @media (prefers-reduced-motion: no-preference) { .choices button { transition: transform .15s ease, background-color .15s ease; } }
  @media (max-width: 767px) { .play-hero { grid-template-columns: 1fr; gap: 24px; padding: 94px 20px 40px; } h1 { font-size: 2.6rem; } .eyebrow { margin-bottom: 12px; } .intro { margin: 16px 0 6px; font-size: 1rem; } .game { padding: 20px; } .game-heading img { width: 64px; height: 64px; } h2 { font-size: 1.35rem; margin-bottom: 16px; } }
</style>
