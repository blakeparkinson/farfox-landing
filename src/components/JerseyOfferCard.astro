---
// One personalizable jersey offer: image with Front/Back toggle, size, name,
// number and the Snipcart add button. The page script drives every
// `.jersey-card`, so cards work the same inside the Other Half pair.
import { kitSlugForName } from '../lib/kits.mjs';

interface Props {
  jersey: { id: string; name: string; price: number; image: string; back?: string | null; sizes?: string[] };
  index: number;
}
const { jersey, index } = Astro.props;
const SITE = 'https://lovefarfox.com';
const kit = kitSlugForName(jersey.name);
const fmt = (price: number) => Number.isInteger(price) ? `$${price}` : `$${price.toFixed(2)}`;
---

<article class="jersey-card rounded-3xl border-2 border-fox-pink/10 bg-fox-bg/40 overflow-hidden hover:border-fox-pink/30 transition-colors" data-product={jersey.id} data-kit={kit}>
  <div class="relative aspect-square bg-gradient-to-br from-fox-bg to-white">
    <img id={`offer-img-${jersey.id}`} src={jersey.image} alt={jersey.name} class="w-full h-full object-contain p-3 transition-opacity duration-150" loading={index > 1 ? 'lazy' : 'eager'} />
    <div class="absolute bottom-3 left-1/2 -translate-x-1/2 flex gap-1 rounded-full bg-white/90 p-1 shadow-md">
      <button type="button" class="offer-view px-4 py-1.5 rounded-full text-xs font-900 bg-fox-pink text-white" data-product={jersey.id} data-src={jersey.image} data-side="front">Front</button>
      <button type="button" class="offer-view px-4 py-1.5 rounded-full text-xs font-900 text-fox-text-light" data-product={jersey.id} data-src={jersey.back} data-side="back">Back</button>
    </div>
  </div>
  <div class="p-5 sm:p-6">
    <div class="flex items-start justify-between gap-4 mb-5">
      <h3 class="font-900 text-xl leading-tight">{jersey.name.replace('Long Distance FC Jersey ', '')}</h3>
      <span class="font-900 text-fox-pink text-xl">{fmt(jersey.price)}</span>
    </div>
    <label class="block text-xs uppercase tracking-wider font-800 text-fox-text-light mb-1.5" for={`size-${jersey.id}`}>Size</label>
    <select id={`size-${jersey.id}`} class="w-full rounded-xl border border-fox-pink/20 bg-white px-3 py-3 text-sm font-800 mb-4">
      {jersey.sizes?.map((size) => <option value={size}>{size}</option>)}
    </select>
    <div class="grid grid-cols-[1fr_5rem] gap-3 mb-4">
      <label class="text-xs uppercase tracking-wider font-800 text-fox-text-light">
        Name
        <input id={`name-${jersey.id}`} type="text" maxlength="14" placeholder="ALEX" class="offer-personalize mt-1.5 w-full rounded-xl border border-fox-pink/20 bg-white px-3 py-3 text-sm font-800 uppercase placeholder:text-fox-text-light/40" />
      </label>
      <label class="text-xs uppercase tracking-wider font-800 text-fox-text-light">
        Number
        <input id={`number-${jersey.id}`} type="text" inputmode="numeric" maxlength="3" placeholder="22" class="offer-personalize mt-1.5 w-full rounded-xl border border-fox-pink/20 bg-white px-3 py-3 text-sm font-800 text-center placeholder:text-fox-text-light/40" />
      </label>
    </div>
    <button
      class="snipcart-add-item offer-add w-full px-6 py-3.5 rounded-full bg-fox-pink text-white font-900 hover:bg-fox-purple hover:shadow-lg hover:shadow-fox-pink/25 transition-all"
      data-item-id={jersey.id}
      data-item-name={jersey.name}
      data-item-price={jersey.price}
      data-item-url="/personalized-long-distance-jersey/"
      data-item-image={`${SITE}${jersey.image}`}
      data-item-description="Personalized Long Distance FC jersey"
      data-item-custom1-name="Size"
      data-item-custom1-options={jersey.sizes?.join('|')}
      data-item-custom1-value={jersey.sizes?.[0]}
      data-item-custom2-name="Name"
      data-item-custom2-required="false"
      data-item-custom2-value=""
      data-item-custom3-name="Number"
      data-item-custom3-required="false"
      data-item-custom3-value=""
    >
      Add personalized jersey to cart
    </button>
    <p class="text-center text-xs text-fox-text-light/70 mt-3">Want a matching set? Personalize and add the second jersey next.</p>
  </div>
</article>
