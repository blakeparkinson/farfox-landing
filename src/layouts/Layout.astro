---
import '../styles/global.css'

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Far Fox — Stay Connected, No Matter the Distance',
  description = 'The couples app for long-distance relationships. Share photos, love letters, daily questions, mood tracking, and more — all wrapped around your own little fox companion.',
  image = 'https://lovefarfox.com/brand-preview.png',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, 'https://lovefarfox.com');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalURL.href} />
    <link rel="alternate" type="application/rss+xml" title="Far Fox Blog" href="https://lovefarfox.com/rss.xml" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Far Fox" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/brand/foxy-icon-v1.png" />
    <link rel="apple-touch-icon" href="/brand/foxy-icon-v1.png" />

    <!-- Fonts — preload for speed -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" />
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet" />

<!-- Capture campaign context before page-specific event handlers run. -->
    <script is:inline src="/acquisition.js"></script>

<!-- Analytics -->
    <script defer src="https://cloud.umami.is/script.js" data-website-id="9094af54-517f-4e51-bc4b-f2bf5f86d7f8"></script>

<!-- Schema.org -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "Far Fox",
      "url": "https://lovefarfox.com",
      "applicationCategory": "LifestyleApplication",
      "operatingSystem": "iOS, Android, Web",
      "description": description,
      "image": "https://lovefarfox.com/brand/foxy-icon-v1.png",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    })} />

<!-- Organization + WebSite entity — helps Google build the brand entity
     and is the prerequisite for a sitelinks search box / knowledge panel. -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Far Fox",
      "url": "https://lovefarfox.com",
      "logo": "https://lovefarfox.com/brand/foxy-icon-v1.png",
      "description": "Far Fox is a couples app for long-distance relationships — daily questions, love letters, shared photos, and a fox companion that grows with your relationship.",
      "sameAs": ["https://app.lovefarfox.com"]
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Far Fox",
      "url": "https://lovefarfox.com",
      "publisher": { "@type": "Organization", "name": "Far Fox" }
    })} />

    <!-- Per-page <head> extras (e.g. Snipcart stylesheet on /shop) -->
    <slot name="head" />
  </head>
  <body class="bg-fox-bg text-fox-text font-display antialiased">
    <slot />
    <script>
      // Preserve acquisition context across the marketing → app boundary and
      // measure every app handoff consistently, regardless of which page owns
      // the CTA. The app can read these query params without a shared cookie.
      const campaignParams = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'];
      const current = new URLSearchParams(window.location.search);
      const acquisition = (window as Window & { farfoxAcquisition?: Record<string, string> }).farfoxAcquisition || {};
      document.querySelectorAll<HTMLAnchorElement>('a[href^="https://app.lovefarfox.com"]').forEach((link) => {
        const destination = new URL(link.href);
        campaignParams.forEach((key) => {
          const value = acquisition[key] || current.get(key);
          if (value && !destination.searchParams.has(key)) destination.searchParams.set(key, value);
        });
        destination.searchParams.set('landing_path', window.location.pathname);
        link.href = destination.toString();
        link.addEventListener('click', () => {
          const analytics = (window as Window & { umami?: { track: (event: string, data?: object) => void } }).umami;
          const eventName = destination.pathname.startsWith('/signup')
            ? 'app_signup_clicked'
            : 'app_open_clicked';
          analytics?.track(eventName, {
            cta: link.dataset.appCta || destination.searchParams.get('ref') || 'unlabeled',
            path: window.location.pathname,
            source: acquisition.utm_source || current.get('utm_source') || 'direct',
            campaign: acquisition.utm_campaign || '',
          });
        });
      });
    </script>
  </body>
</html>
